DATABASE_URL=postgresql+psycopg://media:media@127.0.0.1:5433/media_platform
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
API_SECRET=change-me
MOSS_URL=http://localhost:9000
MOSS_PRELOAD=1
STORAGE_ROOT=./storage

# ---- 用户系统 ----
# JWT 密钥：不设则从 API_SECRET 派生（重启不漂移）；设为 change-me 等弱值会拒绝启动。
# 轮换密钥会使全部已登录会话失效。
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
# 注册开关：open=开放注册；admin_only=仅管理员能建用户（首位用户永远开放）。
REGISTRATION_MODE=open
# 本地开发放行：设为 1 时本地浏览器（localhost Origin）无凭证可直连 API。
# 服务器不要设置（缺省即关）。
AUTH_LOCAL_BYPASS=1

# MOSS 长音频切片并行（可选）：超过 MOSS_CHUNK_SECONDS 的音频会被切片，
# 用 MOSS_CHUNK_WORKERS 个线程并行推理。workers=1 表示关闭切片（说话人标签最连贯）。
# 实测（本机 16 核 CPU）：整段 RTF≈1.30；600s 音频用 4 并行等效 RTF≈0.93；8 并行反而更慢。
MOSS_CHUNK_SECONDS=300
MOSS_CHUNK_WORKERS=4
# 封面等对外链接的 API 基址；本地开发要与实际 API 端口一致
PUBLIC_API_URL=http://127.0.0.1:8010
