DATABASE_URL=postgresql+psycopg://media:media@127.0.0.1:5433/media_platform
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
API_SECRET=change-me
MOSS_URL=http://localhost:9000
MOSS_PRELOAD=1
STORAGE_ROOT=./storage
MOSS_MEDIA_ROOT=./storage
MOSS_MAX_SOURCE_MB=512

# ---- 用户系统 ----
# JWT 密钥：不设则从 API_SECRET 派生（重启不漂移）；设为 change-me 等弱值会拒绝启动。
# 轮换密钥会使全部已登录会话失效。
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
# 注册开关：open=开放注册；admin_only=仅管理员能建用户（首位用户永远开放）。
REGISTRATION_MODE=open
# 本地开发放行：设为 1 时本地浏览器（localhost Origin）无凭证可直连 API。
# 服务器不要设置（缺省即关）。
AUTH_LOCAL_BYPASS=1

# MOSS 长音频切片（可选）。默认 1：同一 FunASR 模型实例不并发 generate，
# 可保证稳定性和跨片说话人标签一致。只有确认当前模型运行时线程安全后才调高。
MOSS_CHUNK_SECONDS=300
MOSS_CHUNK_WORKERS=1
# 封面等对外链接的 API 基址；本地开发要与实际 API 端口一致
PUBLIC_API_URL=http://127.0.0.1:8010
