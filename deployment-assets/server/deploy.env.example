# Copy to deploy.env on the server and fill in (chmod 600). Never commit the real file.
POSTGRES_PASSWORD=replace-with-a-long-random-password
API_SECRET=replace-with-a-long-random-secret
COOKIE_ENCRYPTION_KEY=replace-with-a-different-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Deployment root on the server.
APP_ROOT=/opt/plugin_parser
ASSET_ROOT=/opt/plugin_parser

# Image tag (do not use "latest" so rollbacks stay possible).
IMAGE_TAG=20261008

# Host ports (frozen after server probing; keep out of the way of other services).
WEB_PORT=18100
API_PORT=18300
MOSS_PORT=19300
MOSS_PRELOAD=1

# Browser origins allowed to call the API (comma separated). MUST include the web origin.
ALLOWED_ORIGINS=http://10.0.0.32:18100,http://localhost:18100

# API base URL baked into the web image at BUILD time. Must match the host IP and API_PORT.
NEXT_PUBLIC_API_URL=http://10.0.0.32:18300

# API base URL used for stored-cover links in API responses (runtime). The
# browser loads these directly, so it must be reachable from the browser -
# same value as NEXT_PUBLIC_API_URL. Missing/wrong value = broken cover images.
PUBLIC_API_URL=http://10.0.0.32:18300
