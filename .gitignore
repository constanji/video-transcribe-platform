deployment-assets/**/*.tar.gz
deployment-assets/**/*.gguf
deployment-assets/server/deploy.env
deployment-assets/server/*.bundle
deployment-assets/tools/.remote.env

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
